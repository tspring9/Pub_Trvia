# Copy to .env.dev / .env.prod on the server and fill in.
# Never commit the filled-in copies.

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=pubtrivia
PGPASSWORD=

# dev  -> pubtrivia_dev / PORT=8789
# prod -> pubtrivia     / PORT=8790
PGDATABASE=pubtrivia_dev
PORT=8789

# Prefix on INCOMING urls. Leave EMPTY behind Tailscale Funnel: funnel
# --set-path strips its prefix before proxying, so this server sees "/api/state"
# even though the phone requested "/trivia-dev/api/state".
# Set it only for a reverse proxy that forwards the prefix intact.
BASE_PATH=

# The host password. No default on purpose: the server refuses to boot
# without it, so "changeme" can never reach the public internet.
ADMIN_PASSWORD=

# Optional: bind to the tailnet IP to test from your own phone over Tailscale.
# Leave unset (loopback) when fronting with Funnel.
# HOST=100.x.y.z

# --- build-time, NOT read by the server ---------------------------------
# The browser-facing prefix, baked into asset urls by vite:
#   cd web && PUBLIC_BASE=/trivia-dev npm run build
# Must match the funnel --set-path prefix. Rebuild whenever it changes.
